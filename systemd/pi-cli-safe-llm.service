[Unit]
Description=pi-cli-safe layer 2 — local LLM reviewer
Documentation=https://github.com/fuzzy-logic/pi-cli-safe

[Service]
Type=simple
# Any OpenAI-compatible server works; llama.cpp is just the easy local option.
#
# Model choice is measured, not assumed. Benchmarked on 40 commands (20 safe,
# 20 destructive) -- accuracy / false-safe / median latency:
#
#   Qwen3.5-2B   1.2G   67.5%   1 false-safe, 12 false alarms    447 ms
#   Qwen3-VL-4B  3.2G   95.0%   0 false-safe,  2 false alarms    499 ms  <- default
#   Ornith-9B    7.1G   95.0%   0 false-safe,  2 false alarms   1596 ms
#   Qwen3.6-35B   22G   92.5%   3 false-safe,  0 false alarms   1123 ms
#   GLM-4.7-Flash 25G   97.5%   1 false-safe,  0 false alarms   1114 ms
#
# Bigger is not better here. The two largest models were the most permissive:
# the 35B waved through `rm -rf ~/Documents/archive` and `sudo mkinitcpio -P`.
# For a safety gate the false-safe count is the metric that matters, and only
# the 4B and 9B scored zero. The 4B is three times faster than the 9B.
#
# --reasoning off is essential: a reasoning model spends its whole budget
# thinking and returns empty content, so no verdict ever arrives.
# --n-gpu-layers 99 keeps it off the CPU.
Environment=LLAMA_SERVER=/usr/bin/llama-server
Environment=LLAMA_MODEL=%h/.local/share/models/Qwen3-VL-4B-Instruct-UD-Q4_K_XL.gguf
ExecStart=/bin/sh -c '"$LLAMA_SERVER" -m "$LLAMA_MODEL" --host 127.0.0.1 --port 8127 \
  --ctx-size 8192 --n-gpu-layers 99 --threads 8 --alias reviewer --reasoning off'
Restart=always
RestartSec=5
Nice=10

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
